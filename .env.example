# Dádiva Go — Frontend Next.js
# Copie este ficheiro para .env.local e ajuste os valores.

# URL base da API NestJS (sem barra final) — usada no build e em código server-side legado.
# No browser, pedidos autenticados vão sempre same-origin via BFF (`/api/*`).
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL interna da API Nest para o servidor Next (route handlers BFF / proxy).
# Docker prod: http://api:4000 | dev local: http://127.0.0.1:4000
INTERNAL_API_URL=http://127.0.0.1:4000

# Mesmo segredo da API Nest — usado pelo middleware Next para validar JWT (servidor only).
# Em dev pode ser o valor de env.sample da API; em produção ≥ 32 caracteres aleatórios.
JWT_SECRET=dev-only-change-in-production

# Desactive o proxy BFF em dev apenas para depuração directa ao Nest (não recomendado):
# NEXT_PUBLIC_DEV_API_PROXY=0

# IPs extra para o dev server (HMR via LAN) — separados por vírgula.
# Normalmente não é necessário: o next.config.ts detecta os IPs locais automaticamente.
# Use apenas se tiver IPs de outras redes que não são detectados.
# NEXT_DEV_ORIGINS=192.168.2.100,10.0.0.5

# development | production (em produção a API valida JWT, CORS e DATABASE_URL)
NODE_ENV=development

PORT=4000
# Origem exata do Next.js (obrigatória em produção)
CORS_ORIGIN=http://localhost:3000

# PostgreSQL — credenciais alinhadas a backend/docker-compose.yml
DATABASE_URL=postgresql://dadiva:dadiva@localhost:5432/dadiva?schema=public&connection_limit=15&pool_timeout=30

JWT_SECRET=altere-para-uma-string-longa-e-aleatoria
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

BOOTSTRAP_ADMIN_SECRET=

UPLOAD_DIR=uploads
MAX_MODELAGEM_UPLOAD_MB=15

# URL pública do frontend (links em emails)
# APP_PUBLIC_URL=https://app.seudominio.com

# ── Gmail / SMTP (recuperação de palavra-passe — apenas contas ADMIN) ──
# Senha de App: https://myaccount.google.com/apppasswords (2FA activa)
#
# Fallback quando Admin → Configurações → Email (SMTP) está DESACTIVADO.
# Com SMTP activo na app, estes valores são ignorados — o admin muda conta
# pela interface, sem editar código fonte nem redeploy.
MAIL_PROVIDER=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
# Opcional — se vazio, usa "Dádiva Go <EMAIL_USER>"
EMAIL_FROM=

MAIL_APP_NAME=Dádiva Go
MAIL_PASSWORD_RESET_CODE_MINUTES=10
SMTP_VERIFY_ON_START=false

# Resend (alternativa HTTP)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx

# ── Twilio SMS (aviso pedido finalizado → cliente) ──
# Guia completo: docs/TWILIO-SMS-ANGOLA.md (na raiz do projecto)
# Console: https://console.twilio.com/
#
# TWILIO_SMS_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Angola (recomendado): sender alfanumérico — máx. 11 caracteres (sem acentos)
# TWILIO_SMS_FROM=GRAF DADIVA
#
# Alternativa: número E.164 (+244... se disponível na conta)
# TWILIO_SMS_FROM=+2449XXXXXXXX
#
# Evitar em produção: número +1 (EUA) — clientes desconfiam

# Copie para .env.prod e preencha antes de: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=dadiva
POSTGRES_PASSWORD=altere-password-postgres-forte
POSTGRES_DB=dadiva

# ── Portas expostas no host ──────────────────────────────────────────────────
# Só o frontend deve ser público (reverse proxy → :3000).
# A API Nest fica na rede Docker interna (INTERNAL_API_URL=http://api:4000).
FRONTEND_PORT=3000
# API_PORT removido de propósito — não publicar :4000 no host.

# ── Frontend (URL pública — same-origin; browser usa /api via BFF) ────────────
NEXT_PUBLIC_API_URL=https://app.seudominio.com
INTERNAL_API_URL=http://api:4000

# ── API NestJS (obrigatório em produção) ─────────────────────────────────────
# O frontend usa JWT_SECRET no middleware (mesmo valor que a API).
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
CORS_ORIGIN=https://app.seudominio.com
APP_PUBLIC_URL=https://app.seudominio.com
BOOTSTRAP_ADMIN_SECRET=token-secreto-para-primeiro-admin

# ── Email (obrigatório — recuperação de palavra-passe) ───────────────────────
MAIL_PROVIDER=smtp
MAIL_FROM=Dádiva Go <noreply@seudominio.com>
SMTP_HOST=smtp.seudominio.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=noreply@seudominio.com
SMTP_PASS=senha-de-app

# ── MFA (opcional) ───────────────────────────────────────────────────────────
# Se true/1: contas ADMIN sem MFA são redireccionadas para configurar TOTP.
# Por omissão desligado — o TOTP continua disponível em Configurações → Sistema.
MFA_REQUIRE_ADMIN=false

# ── AI service (rede interna Docker — não expor :8000 publicamente) ───────────
AI_CORS_ORIGINS=
AI_SERVICE_API_KEY=chave-interna-opcional
